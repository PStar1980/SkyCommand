NODE_ENV=development
PORT=7070
ADMIN_PORT=7171

MONGO_URI=mongodb://localhost:27017/skycommand
JWT_SECRET=change_me

PGHOST=localhost
PGPORT=5432
PGDATABASE=skyserver_dev
# The physical PostgreSQL database name is intentionally retained during the repository identity cutover.
# Rename it separately only after all clients and scripts are prepared for a database maintenance window.
PGUSER=postgres
PGPASSWORD=your_password_here

# PostgreSQL Docker migration lane. During pre-cutover acceptance the candidate database
# is published on 55432 while the existing Windows PostgreSQL service remains on 5432.
# Docker application services stay on the existing host database until the explicit cutover command.
# db:docker:cutover writes SKYCOMMAND_DATABASE_HOST=postgres and moves host-side PGHOST/PGPORT
# to the published Docker candidate endpoint while leaving Windows PostgreSQL available for immediate rollback.
SKYCOMMAND_POSTGRES_IMAGE=postgres:18.6-bookworm
SKYCOMMAND_POSTGRES_HOST_PORT=55432
SKYCOMMAND_POSTGRES_SOURCE_PORT=5432
SKYCOMMAND_DATABASE_HOST=host.docker.internal
SKYCOMMAND_DATABASE_PORT=5432
# Optional host backup directory. Defaults to ~/.skycommand/backups/postgres when blank.
SKYCOMMAND_POSTGRES_BACKUP_DIR=
# Optional database-build locale overrides. Leave blank to inherit the PostgreSQL cluster locale.
DB_BUILD_LC_COLLATE=
DB_BUILD_LC_CTYPE=
DB_BUILD_LOCALE_PROVIDER=

AUTH_REVOKE_SESSIONS_ON_START=true
AUTH_SESSION_MINUTES=30

# Local Docker backend (Temporal service + Temporal worker + Node worker + optional API)
# Required before starting the Docker worker. Use the host path to the SkyEco System folder.
# On Windows, forward slashes keep Compose interpolation predictable.
SKYCOMMAND_DOCKER_WORKSPACE_ROOT=C:/Users/your-user/Dropbox/Programming/SkyEco System
# Git-changing tools fail closed until the Docker worker has explicit GitHub credentials.
SKYCOMMAND_DOCKER_GIT_ENABLED=false
# Host file containing only a fine-grained GitHub PAT. Keep it outside the repository.
SKYCOMMAND_DOCKER_GITHUB_TOKEN_FILE=
SKYCOMMAND_GITHUB_HOST=github.com
SKYCOMMAND_GITHUB_USERNAME=
# Commit identity used by Git inside the Linux worker container.
SKYCOMMAND_GIT_AUTHOR_NAME=
SKYCOMMAND_GIT_AUTHOR_EMAIL=
# Dockerized scheduler/listener worker controls. The container uses a stable worker name so restarts update one row instead of creating new nodes.
WORKER_SCHEDULER_ENABLED=true
WORKER_LISTENER_ENABLED=false
WORKER_SCHEDULE_POLL_SECONDS=15
WORKER_HEARTBEAT_SECONDS=30

# Docker Admin-Web/deployment mode publishes NGINX on the same local port used by Vite.
# Stop the host `npm run web` process before starting Docker Web so the port is free.
SKYCOMMAND_WEB_PORT=15171

# API Docker publishing remains localhost-only. Host Vite proxies /api to localhost:7171;
# Docker Web proxies the same-origin routes to the Compose service `api:7171`.
# Stop the host `npm run api` process before starting the Docker API so port 7171 is free.
API_PORT=7171
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Durable protocol identifier retained so existing Temporal histories stay routable.
TEMPORAL_TASK_QUEUE=skyserver-local
TEMPORAL_FRED_WORKFLOW_ID_PREFIX=skycommand-fred-ingestion
TEMPORAL_UI_BASE_URL=http://localhost:8600
TEMPORAL_FRED_ACTIVITY_TIMEOUT_MS=1800000

# Host-side Temporal activity worker for operations that must mutate host-owned resources.
# Keep the task queue private to trusted host agents; Docker services only dispatch through Temporal.
SKYCOMMAND_HOST_AGENT_ENABLED=false
SKYCOMMAND_HOST_AGENT_TASK_QUEUE=skycommand-host-local
SKYCOMMAND_HOST_AGENT_PROFILE=DEV_LOCAL
SKYCOMMAND_HOST_AGENT_HEARTBEAT_INTERVAL_MS=15000
SKYCOMMAND_HOST_AGENT_HEARTBEAT_DB_CONNECT_TIMEOUT_MS=3000
# Phase 17 Docker provider. Inventory commands execute only on the host-native Host Agent.
SKYCOMMAND_DOCKER_TARGET_CODE=LOCAL_DOCKER
SKYCOMMAND_DOCKER_TARGET_NAME=Local Docker
SKYCOMMAND_DOCKER_COMMAND_TIMEOUT_MS=10000
SKYCOMMAND_DOCKER_CONTROL_TIMEOUT_MS=120000
SKYCOMMAND_DOCKER_CONTAINER_TIMEOUT_MS=30000
SKYCOMMAND_DOCKER_RESOURCE_TIMEOUT_MS=30000
SKYCOMMAND_DOCKER_SELF_PROJECT_NAME=skycommand
# Phase 17.6 live Docker event lane. The host-native agent observes container
# events directly and relays normalized metadata to the localhost-only API.
# Set false to keep inventory/control active while disabling live events.
SKYCOMMAND_DOCKER_EVENT_STREAM_ENABLED=true
SKYCOMMAND_DOCKER_EVENT_HEARTBEAT_MS=15000
SKYCOMMAND_DOCKER_EVENT_RESTART_MS=5000
SKYCOMMAND_DOCKER_EVENT_POST_TIMEOUT_MS=5000
# Optional override; defaults to http://127.0.0.1:${API_PORT}/api/infrastructure/providers/docker/events/ingest
SKYCOMMAND_DOCKER_EVENT_INGEST_URL=

# Phase 17.6.2 live resource telemetry. Docker stats are sampled on the host and
# only normalized CPU/memory/I/O/PID fields are relayed; raw inspect/env data is not exposed.
SKYCOMMAND_DOCKER_TELEMETRY_ENABLED=true
SKYCOMMAND_DOCKER_TELEMETRY_INTERVAL_MS=5000
SKYCOMMAND_DOCKER_TELEMETRY_POST_TIMEOUT_MS=5000
SKYCOMMAND_DOCKER_TELEMETRY_COMMAND_TIMEOUT_MS=10000
# Optional override; defaults to http://127.0.0.1:${API_PORT}/api/infrastructure/providers/docker/telemetry/ingest
SKYCOMMAND_DOCKER_TELEMETRY_INGEST_URL=

# Statistics Canada ingestion tuning
# StatCan WDS can reject aggressive bursts; keep this lower than FRED/BoC.
STATCAN_INGESTION_CONCURRENCY=2
STATCAN_INGESTION_MAX_CONCURRENCY=3
STATCAN_REQUEST_MAX_ATTEMPTS=4
STATCAN_RETRY_DELAY_MS=750

# Canonical SkyCommand internal service auth for Workflow API_CALL nodes that call protected local SkyCommand API routes.
# Set the same value for api/worker/temporal-worker processes. Leave blank to disable.
SKYCOMMAND_INTERNAL_API_AUTH_ENABLED=true
SKYCOMMAND_INTERNAL_API_TOKEN=change_me_internal_dev_token

# SkyCommand Core workflow launcher.
# Legacy SKYSERVER_* variable names remain accepted temporarily by the runtime for a safe transition.
# Runtime parameters are prompted from the published workflow schema. Temporal runs can be followed
# directly from the PostgreSQL workflow ledger without depending on Admin-Web or Vite.
SKYCOMMAND_CORE_APP_CODE=SKYSERVER_CORE
SKYCOMMAND_CONFIG_PROFILE=DEV_LOCAL
SKYCOMMAND_CORE_WORKFLOW_EXECUTOR_MODE=temporal
SKYCOMMAND_CORE_WORKFLOW_FOLLOW=true
SKYCOMMAND_CORE_WORKFLOW_POLL_MS=2000
SKYCOMMAND_CORE_WORKFLOW_FOLLOW_TIMEOUT_MS=1800000

# Phase 14 structured tool result transport.
# Human stdout/stderr remains in Tool History; workflow-safe JSON uses a separate wrapper-owned file.
SKYCOMMAND_TOOL_RESULT_MAX_BYTES=1048576
# Maximum bytes read from each retained stdout/stderr log when one Tool History execution is opened.
# Values above 5 MB are capped by the API.
TOOL_HISTORY_MAX_OUTPUT_BYTES=500000

# Git automation safety.
# Individual Git commands fail rather than waiting indefinitely for credentials, editors, or remote I/O.
SKYCOMMAND_GIT_COMMAND_TIMEOUT_MS=60000

# PostgreSQL health/comparison tool timeouts and bounded structured detail.
DB_HEALTH_CONNECTION_TIMEOUT_MS=10000
DB_HEALTH_STATEMENT_TIMEOUT_MS=15000
# Optional override. Without this setting, direct CLI is strict and managed SkyCommand runs are condition-friendly.
# DB_HEALTH_FAIL_WHEN_OFFLINE=true
DB_COMPARE_CONNECTION_TIMEOUT_MS=10000
DB_COMPARE_STATEMENT_TIMEOUT_MS=120000
DB_COMPARE_MAX_DIFFERENCE_DETAILS=1000

# Persistent API request telemetry retention (days)
API_TELEMETRY_RETENTION_DAYS=30
