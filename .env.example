NODE_ENV=development
PORT=7070
ADMIN_PORT=7171

MONGO_URI=mongodb://localhost:27017/skycommand
JWT_SECRET=change_me

PGHOST=localhost
PGPORT=5432
PGDATABASE=skyserver_dev
# The physical PostgreSQL database name is intentionally retained during the repository identity cutover.
# Rename it separately only after all clients and scripts are prepared for a database maintenance window.
PGUSER=postgres
PGPASSWORD=your_password_here

AUTH_REVOKE_SESSIONS_ON_START=true
AUTH_SESSION_MINUTES=30

# Temporal local development (Dockerized service; SkyCommand worker remains host-run for now)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Durable protocol identifier retained so existing Temporal histories stay routable.
TEMPORAL_TASK_QUEUE=skyserver-local
TEMPORAL_FRED_WORKFLOW_ID_PREFIX=skycommand-fred-ingestion
TEMPORAL_UI_BASE_URL=http://localhost:8600
TEMPORAL_FRED_ACTIVITY_TIMEOUT_MS=1800000

# Statistics Canada ingestion tuning
# StatCan WDS can reject aggressive bursts; keep this lower than FRED/BoC.
STATCAN_INGESTION_CONCURRENCY=2
STATCAN_INGESTION_MAX_CONCURRENCY=3
STATCAN_REQUEST_MAX_ATTEMPTS=4
STATCAN_RETRY_DELAY_MS=750

# Canonical SkyCommand internal service auth for Workflow API_CALL nodes that call protected local SkyCommand API routes.
# Set the same value for api/worker/temporal-worker processes. Leave blank to disable.
SKYCOMMAND_INTERNAL_API_AUTH_ENABLED=true
SKYCOMMAND_INTERNAL_API_TOKEN=change_me_internal_dev_token

# SkyCommand Core workflow launcher.
# Legacy SKYSERVER_* variable names remain accepted temporarily by the runtime for a safe transition.
# Runtime parameters are prompted from the published workflow schema. Temporal runs can be followed
# directly from the PostgreSQL workflow ledger without depending on Admin-Web or Vite.
SKYCOMMAND_CORE_APP_CODE=SKYSERVER_CORE
SKYCOMMAND_CONFIG_PROFILE=DEV_LOCAL
SKYCOMMAND_CORE_WORKFLOW_EXECUTOR_MODE=temporal
SKYCOMMAND_CORE_WORKFLOW_FOLLOW=true
SKYCOMMAND_CORE_WORKFLOW_POLL_MS=2000
SKYCOMMAND_CORE_WORKFLOW_FOLLOW_TIMEOUT_MS=1800000

# Phase 14 structured tool result transport.
# Human stdout/stderr remains in Tool History; workflow-safe JSON uses a separate wrapper-owned file.
SKYCOMMAND_TOOL_RESULT_MAX_BYTES=1048576
# Maximum bytes read from each retained stdout/stderr log when one Tool History execution is opened.
# Values above 5 MB are capped by the API.
TOOL_HISTORY_MAX_OUTPUT_BYTES=500000

# Git automation safety.
# Individual Git commands fail rather than waiting indefinitely for credentials, editors, or remote I/O.
SKYCOMMAND_GIT_COMMAND_TIMEOUT_MS=60000

# PostgreSQL health/comparison tool timeouts and bounded structured detail.
DB_HEALTH_CONNECTION_TIMEOUT_MS=10000
DB_HEALTH_STATEMENT_TIMEOUT_MS=15000
# Optional override. Without this setting, direct CLI is strict and managed SkyCommand runs are condition-friendly.
# DB_HEALTH_FAIL_WHEN_OFFLINE=true
DB_COMPARE_CONNECTION_TIMEOUT_MS=10000
DB_COMPARE_STATEMENT_TIMEOUT_MS=120000
DB_COMPARE_MAX_DIFFERENCE_DETAILS=1000

# Persistent API request telemetry retention (days)
API_TELEMETRY_RETENTION_DAYS=30
