NODE_ENV=development
PORT=7070
ADMIN_PORT=7171

MONGO_URI=mongodb://localhost:27017/skyserver
JWT_SECRET=change_me

PGHOST=localhost
PGPORT=5432
PGDATABASE=skyserver_dev
PGUSER=postgres
PGPASSWORD=your_password_here

AUTH_REVOKE_SESSIONS_ON_START=true
AUTH_SESSION_MINUTES=30

# Temporal local development / Phase 10 pilot
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=skyserver-local
TEMPORAL_FRED_WORKFLOW_ID_PREFIX=skyserver-fred-ingestion
TEMPORAL_UI_BASE_URL=http://localhost:8233
TEMPORAL_FRED_ACTIVITY_TIMEOUT_MS=1800000

# Statistics Canada ingestion tuning
# StatCan WDS can reject aggressive bursts; keep this lower than FRED/BoC.
STATCAN_INGESTION_CONCURRENCY=2
STATCAN_INGESTION_MAX_CONCURRENCY=3
STATCAN_REQUEST_MAX_ATTEMPTS=4
STATCAN_RETRY_DELAY_MS=750

# Internal service auth for Workflow API_CALL nodes that call protected local SkyServer API routes.
# Set the same value for api/worker/temporal-worker processes. Leave blank to disable.
SKYSERVER_INTERNAL_API_AUTH_ENABLED=true
SKYSERVER_INTERNAL_API_TOKEN=change_me_internal_dev_token

# SkyServer Core workflow launcher.
# Runtime parameters are prompted from the published workflow schema. Temporal runs can be followed
# directly from the PostgreSQL workflow ledger without depending on Admin-Web or Vite.
SKYSERVER_CORE_WORKFLOW_EXECUTOR_MODE=temporal
SKYSERVER_CORE_WORKFLOW_FOLLOW=true
SKYSERVER_CORE_WORKFLOW_POLL_MS=2000
SKYSERVER_CORE_WORKFLOW_FOLLOW_TIMEOUT_MS=1800000

# Phase 14 structured tool result transport.
# Human stdout/stderr remains in Tool History; workflow-safe JSON uses a separate wrapper-owned file.
SKYCOMMAND_TOOL_RESULT_MAX_BYTES=1048576
