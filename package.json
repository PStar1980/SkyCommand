{
  "name": "skyserver",
  "version": "1.0.0",
  "description": "Private Admin & Automation Hub for the Sky Ecosystem.",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "test": "npm run validate",
    "start": "node apps/api/src/server.js",
    "api": "nodemon apps/api/src/server.js",
    "worker": "node apps/worker/src/index.js",
    "worker:dev": "nodemon apps/worker/src/index.js",
    "temporal:worker": "node packages/temporal/src/worker.js",
    "temporal:worker:dev": "nodemon packages/temporal/src/worker.js",
    "temporal:health": "node packages/temporal/src/temporalHealth.js",
    "temporal:fred": "node packages/temporal/src/startFredIngestionWorkflow.js",
    "web": "vite --config apps/admin-web/vite.config.js",
    "web:build": "vite build --config apps/admin-web/vite.config.js",
    "web:preview": "vite preview --config apps/admin-web/vite.config.js",
    "daemon": "nodemon apps/api/src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "npm run lint:fix && npm run format",
    "prepush": "npm run validate",
    "db:health": "node packages/db/src/db_health.js",
    "db:build": "node packages/db_build/src/db_build.js",
    "auth:create-admin": "node packages/auth/src/createAdminUser.js",
    "core": "node packages/core/src/SkyServer_Core.js",
    "precommit": "npm run validate",
    "validate": "node --check apps/api/src/services/temporalService.js && node --check apps/api/src/controllers/temporalController.js && node --check apps/api/src/routes/temporal.routes.js && node --check packages/temporal/src/config.js && node --check packages/temporal/src/worker.js && node --check packages/temporal/src/temporalHealth.js && node --check packages/temporal/src/startFredIngestionWorkflow.js && node --check packages/temporal/src/activities/fredActivities.js && node --check packages/temporal/src/activities/index.js && node --check packages/temporal/src/workflows/fredIngestionWorkflow.js && node --check packages/temporal/src/workflows/index.js && node --check packages/files/src/generateRepoMap.js && node --check packages/files/src/generateRepoZip.js"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PStar1980/SkyServer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/PStar1980/SkyServer/issues"
  },
  "homepage": "https://github.com/PStar1980/SkyServer#readme",
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.8",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "xlsx": "^0.18.5",
    "@temporalio/client": "^1.18.1",
    "@temporalio/common": "^1.18.1",
    "@temporalio/worker": "^1.18.1",
    "@temporalio/workflow": "^1.18.1",
    "@temporalio/activity": "^1.18.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "nodemon": "^3.1.11",
    "prettier": "^3.6.2",
    "vite": "^8.0.10"
  }
}
