{
  "manifestVersion": "1.0",
  "toolCode": "ingestion_boc",
  "displayName": "Run Bank of Canada Ingestion",
  "description": "Loads active Bank of Canada macroeconomic indicators into PostgreSQL with optional selected indicators and batched concurrency.",
  "runtime": {
    "type": "node",
    "entrypoint": "packages/ingestion/src/loadBoCMacroData.js"
  },
  "parameters": [
    {
      "name": "indicators",
      "label": "Indicators",
      "description": "Optional Bank of Canada indicator codes. Leave blank to process the full configured catalogue.",
      "type": "string_array",
      "required": false,
      "secret": false,
      "defaultValue": [],
      "binding": {
        "mode": "argv_flag",
        "flag": "--indicators",
        "repeat": false,
        "separator": ","
      }
    },
    {
      "name": "concurrency",
      "label": "Concurrency",
      "description": "Maximum number of Bank of Canada indicators processed concurrently.",
      "type": "integer",
      "required": false,
      "secret": false,
      "defaultValue": 3,
      "binding": {
        "mode": "argv_flag",
        "flag": "--concurrency",
        "repeat": false,
        "separator": ","
      }
    }
  ],
  "resultContract": {
    "required": true,
    "schemaVersion": "1.0",
    "outputType": "macro_ingestion_summary.v1",
    "schemaPath": "packages/tools/contracts/macro_ingestion_summary.v1.schema.json",
    "samplePath": "packages/ingestion/manifests/ingestion_boc/contract-check-result.json"
  },
  "permissions": ["INGESTION_RUN_BOC"],
  "execution": {
    "timeoutMs": 1800000,
    "allowManual": true,
    "allowSchedules": true,
    "allowWorkflows": true,
    "capturesOutput": true
  },
  "registration": {
    "applicationCode": "SKYSERVER_CORE",
    "categoryCode": "data_ingestion_tools",
    "riskCode": "medium",
    "requiresConfirmation": true,
    "confirmationText": "This will call the Bank of Canada ingestion pipeline and write any new data into PostgreSQL."
  }
}
