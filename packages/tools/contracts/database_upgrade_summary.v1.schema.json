{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skycommand.local/contracts/database_upgrade_summary.v1.schema.json",
  "title": "SkyCommand database upgrade summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "mode",
    "databaseIdentity",
    "baseline",
    "sourceRevision",
    "execution",
    "binding",
    "planDigest",
    "manifestDigest",
    "pendingCount",
    "pendingChanges",
    "appliedCount",
    "fileOutcomes",
    "ledger",
    "lock",
    "revalidation",
    "outcome",
    "warnings",
    "errors",
    "timing"
  ],
  "properties": {
    "contract": { "const": "database_upgrade_summary.v1" },
    "mode": { "enum": ["PLAN", "APPLY"] },
    "databaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseName", "serverVersion", "serverPort", "systemIdentifier"],
      "properties": {
        "databaseName": { "type": ["string", "null"] },
        "serverVersion": { "type": ["string", "null"] },
        "serverPort": { "type": ["integer", "null"], "minimum": 0 },
        "systemIdentifier": { "type": ["string", "null"] }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "contract", "ordinal", "recorded", "probes"],
      "properties": {
        "status": { "enum": ["VERIFIED", "NOT_INITIALIZED", "FAILED", "UNKNOWN"] },
        "contract": { "type": ["string", "null"] },
        "ordinal": { "type": "integer", "minimum": 0 },
        "recorded": { "type": "boolean" },
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "evidence"],
            "properties": {
              "name": { "type": "string" },
              "status": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
              "evidence": { "type": "object" }
            }
          }
        }
      }
    },
    "sourceRevision": { "type": ["string", "null"] },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "toolCode", "executionId", "reconciledFromLedger"],
      "properties": {
        "path": { "type": ["string", "null"] },
        "toolCode": { "type": ["string", "null"] },
        "executionId": { "type": ["string", "null"] },
        "reconciledFromLedger": { "type": "boolean" }
      }
    },
    "binding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "environmentCode",
        "repositoryCode",
        "repositoryId",
        "toolCode",
        "toolId",
        "permissionCode"
      ],
      "properties": {
        "environmentCode": { "type": "string" },
        "repositoryCode": { "type": "string" },
        "repositoryId": { "type": "string" },
        "toolCode": { "type": "string" },
        "toolId": { "type": "string" },
        "permissionCode": { "type": "string" }
      }
    },
    "planDigest": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "digest": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    },
    "manifestDigest": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "digest": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    },
    "pendingCount": { "type": "integer", "minimum": 0 },
    "pendingChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "kind", "relativePath", "sha256"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["MIGRATION", "SEED"] },
          "relativePath": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\.\\.).+$"
          },
          "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
        }
      }
    },
    "appliedCount": { "type": "integer", "minimum": 0 },
    "fileOutcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "kind",
          "relativePath",
          "sha256",
          "status",
          "rolledBack",
          "errorCode"
        ],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["MIGRATION", "SEED"] },
          "relativePath": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\.\\.).+$"
          },
          "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
          "status": {
            "enum": [
              "ALREADY_LEDGERED",
              "COMMITTED",
              "COMMITTED_RECONCILED",
              "FAILED",
              "FAILED_ROLLED_BACK",
              "PENDING_NOT_ATTEMPTED"
            ]
          },
          "rolledBack": { "type": "boolean" },
          "errorCode": { "type": ["string", "null"] }
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "verification", "appliedCount", "driftDetected"],
      "properties": {
        "available": { "type": "boolean" },
        "verification": { "enum": ["VERIFIED", "NOT_INITIALIZED", "DRIFT", "FAILED", "UNKNOWN"] },
        "appliedCount": { "type": "integer", "minimum": 0 },
        "driftDetected": { "type": "boolean" },
        "receipts": { "type": "array" },
        "before": { "$ref": "#/$defs/ledgerSnapshot" },
        "after": { "$ref": "#/$defs/ledgerSnapshot" }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "acquired", "released", "mechanism"],
      "properties": {
        "requested": { "type": "boolean" },
        "acquired": { "type": "boolean" },
        "released": { "type": "boolean" },
        "mechanism": { "type": ["string", "null"] }
      }
    },
    "revalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "outcome", "manifestDigest"],
      "properties": {
        "performed": { "type": "boolean" },
        "outcome": { "type": "string" },
        "manifestDigest": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": { "const": "SHA-256" },
            "digest": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
          }
        }
      }
    },
    "outcome": { "enum": ["PLAN_READY", "APPLIED", "NO_CHANGES", "BLOCKED", "FAILED"] },
    "warnings": { "type": "array" },
    "errors": { "type": "array" },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "completedAt", "durationMs"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "ledgerSnapshot": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["available", "verification", "appliedCount", "ordinals"],
      "properties": {
        "available": { "type": "boolean" },
        "verification": { "enum": ["VERIFIED", "NOT_INITIALIZED", "DRIFT", "FAILED", "UNKNOWN"] },
        "appliedCount": { "type": "integer", "minimum": 0 },
        "ordinals": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    }
  }
}
