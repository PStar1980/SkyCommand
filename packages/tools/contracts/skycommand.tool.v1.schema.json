{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skycommand.local/contracts/skycommand.tool.v1.schema.json",
  "title": "SkyCommand Tool Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "toolCode",
    "displayName",
    "description",
    "runtime",
    "parameters",
    "resultContract",
    "permissions",
    "execution",
    "registration"
  ],
  "properties": {
    "manifestVersion": { "const": "1.0" },
    "toolCode": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_:-]{2,79}$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 4000 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "entrypoint"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["node", "powershell", "pwsh", "python"]
        },
        "entrypoint": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/parameter" }
    },
    "resultContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "schemaVersion", "outputType", "schemaPath", "samplePath"],
      "properties": {
        "required": { "type": "boolean" },
        "schemaVersion": { "type": "string", "minLength": 1, "maxLength": 20 },
        "outputType": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.:-]{2,119}$"
        },
        "schemaPath": { "type": ["string", "null"], "maxLength": 500 },
        "samplePath": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 30,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,99}$"
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeoutMs",
        "allowManual",
        "allowSchedules",
        "allowWorkflows",
        "capturesOutput"
      ],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "allowManual": { "type": "boolean" },
        "allowSchedules": { "type": "boolean" },
        "allowWorkflows": { "type": "boolean" },
        "capturesOutput": { "type": "boolean" }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationCode",
        "categoryCode",
        "riskCode",
        "requiresConfirmation",
        "confirmationText"
      ],
      "properties": {
        "applicationCode": { "type": ["string", "null"], "maxLength": 100 },
        "categoryCode": { "type": ["string", "null"], "maxLength": 100 },
        "riskCode": { "type": ["string", "null"], "maxLength": 50 },
        "requiresConfirmation": { "type": "boolean" },
        "confirmationText": { "type": "string", "maxLength": 1000 }
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "description",
        "type",
        "required",
        "secret",
        "defaultValue",
        "allowedValues",
        "binding"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1000 },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "select",
            "string_array",
            "date",
            "json",
            "path"
          ]
        },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" },
        "defaultValue": {},
        "allowedValues": { "type": ["array", "null"] },
        "binding": { "$ref": "#/$defs/binding" }
      }
    },
    "binding": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["argv_flag", "argv_positional", "environment", "stdin_json"]
        },
        "flag": { "type": "string" },
        "repeat": { "type": "boolean" },
        "separator": { "type": "string" },
        "position": { "type": "integer", "minimum": 0, "maximum": 99 },
        "variable": { "type": "string" },
        "property": { "type": "string" }
      }
    }
  }
}
