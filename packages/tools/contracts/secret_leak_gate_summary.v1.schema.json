{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skycommand.local/contracts/secret_leak_gate_summary.v1.schema.json",
  "title": "Secret Leak Gate Summary v1 Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactKind",
    "outcome",
    "gateStatus",
    "repositoryName",
    "repositoryRoot",
    "workflowRunId",
    "startedAt",
    "completedAt",
    "durationMs",
    "filesScanned",
    "artifactsScanned",
    "findingsCount",
    "severityCounts",
    "rulesVersion",
    "sourceIdentityDigest",
    "artifactIdentityDigest",
    "artifacts",
    "findings",
    "blockedReason",
    "policy"
  ],
  "properties": {
    "artifactKind": { "const": "SECRET_LEAK_GATE" },
    "outcome": { "type": "string", "enum": ["PASS", "BLOCKED"] },
    "gateStatus": { "type": "string", "enum": ["PASSED", "BLOCKED"] },
    "repositoryName": { "type": "string", "minLength": 1, "maxLength": 240 },
    "repositoryRoot": { "type": ["string", "null"], "maxLength": 4000 },
    "workflowRunId": { "type": ["string", "null"], "maxLength": 200 },
    "startedAt": {
      "type": ["string", "null"],
      "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
    },
    "completedAt": {
      "type": ["string", "null"],
      "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
    },
    "durationMs": { "type": "number", "minimum": 0 },
    "filesScanned": { "type": "number", "minimum": 0 },
    "artifactsScanned": { "type": "number", "minimum": 0 },
    "findingsCount": { "type": "number", "minimum": 0 },
    "severityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HIGH", "MEDIUM"],
      "properties": {
        "HIGH": { "type": "number", "minimum": 0 },
        "MEDIUM": { "type": "number", "minimum": 0 }
      }
    },
    "rulesVersion": { "type": "string", "const": "1.0.0" },
    "sourceIdentityDigest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactIdentityDigest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "bytes", "sha256", "entriesScanned"],
        "properties": {
          "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
          "path": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "bytes": { "type": "number", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "entriesScanned": { "type": "number", "minimum": 0 }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "path",
          "archiveEntry",
          "lineNumber",
          "ruleId",
          "category",
          "severity",
          "valueRedacted",
          "remediation"
        ],
        "properties": {
          "scope": { "type": "string", "enum": ["SOURCE", "ARTIFACT"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "archiveEntry": { "type": ["string", "null"], "maxLength": 2000 },
          "lineNumber": { "type": ["number", "null"], "minimum": 1 },
          "ruleId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "category": { "type": "string", "minLength": 1, "maxLength": 100 },
          "severity": { "type": "string", "enum": ["HIGH", "MEDIUM"] },
          "valueRedacted": { "const": true },
          "remediation": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "blockedReason": { "type": ["string", "null"], "maxLength": 120 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceScope",
        "generatedArtifactsRequired",
        "rawSecretsRedacted",
        "personalPathsExcluded",
        "bypassesAllowed"
      ],
      "properties": {
        "sourceScope": { "const": "GIT_ADD_A" },
        "generatedArtifactsRequired": { "const": true },
        "rawSecretsRedacted": { "const": true },
        "personalPathsExcluded": { "const": true },
        "bypassesAllowed": { "const": false }
      }
    }
  }
}
