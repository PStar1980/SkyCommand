{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skycommand.local/contracts/git_branch_sync_summary.v1.schema.json",
  "title": "Git Branch Synchronization Summary v1 Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationKind",
    "executionStrategy",
    "watcherSafe",
    "outcome",
    "repositoryCode",
    "repositoryName",
    "repositoryRoot",
    "remote",
    "sourceBranch",
    "targetBranch",
    "mainBranch",
    "devBranch",
    "mainHeadBeforeSha",
    "mainHeadSha",
    "devHeadBeforePullSha",
    "devHeadBeforeSha",
    "devHeadAfterSha",
    "synchronizedHeadSha",
    "commitsApplied",
    "devAdvanced",
    "branchesSynchronized",
    "tagName",
    "tagCreated",
    "startedAt",
    "completedAt",
    "durationMs",
    "steps",
    "currentBranch",
    "localHeadBeforeSha",
    "localHeadAfterSha",
    "localDevHeadBeforeSha",
    "remoteDevHeadBeforeSha",
    "remoteDevHeadAfterSha",
    "localMainRefUpdated",
    "localDevRefUpdated",
    "localWorkspaceUpdated",
    "localWorkspaceRefreshRequired",
    "localRefreshCommand",
    "localHostSyncRequired",
    "deferredLocalBranches",
    "localSyncCommandTemplate"
  ],
  "properties": {
    "operationKind": {
      "const": "MAIN_TO_DEV_SYNC"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "SYNCHRONIZED",
        "ALREADY_SYNCHRONIZED",
        "TAGGED",
        "FAILED"
      ]
    },
    "repositoryCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "repositoryName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 240
    },
    "repositoryRoot": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "remote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sourceBranch": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "targetBranch": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "mainBranch": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "devBranch": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "mainHeadBeforeSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "mainHeadSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "devHeadBeforePullSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "devHeadBeforeSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "devHeadAfterSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "synchronizedHeadSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "commitsApplied": {
      "type": "number",
      "minimum": 0
    },
    "devAdvanced": {
      "type": "boolean"
    },
    "branchesSynchronized": {
      "type": "boolean"
    },
    "tagName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "tagCreated": {
      "type": "boolean"
    },
    "startedAt": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "completedAt": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fetched",
        "mainBranchSelected",
        "mainBranchPulled",
        "devBranchSelected",
        "devBranchPulled",
        "fastForwardMerged",
        "mainBranchPushed",
        "devBranchPushed",
        "tagCreated",
        "tagsPushed",
        "remoteFastForwardVerified",
        "localMainRefUpdated",
        "localDevRefUpdated",
        "localWorkspaceUpdated"
      ],
      "properties": {
        "fetched": {
          "type": "boolean"
        },
        "mainBranchSelected": {
          "type": "boolean"
        },
        "mainBranchPulled": {
          "type": "boolean"
        },
        "devBranchSelected": {
          "type": "boolean"
        },
        "devBranchPulled": {
          "type": "boolean"
        },
        "fastForwardMerged": {
          "type": "boolean"
        },
        "mainBranchPushed": {
          "type": "boolean"
        },
        "devBranchPushed": {
          "type": "boolean"
        },
        "tagCreated": {
          "type": "boolean"
        },
        "tagsPushed": {
          "type": "boolean"
        },
        "remoteFastForwardVerified": {
          "type": "boolean"
        },
        "localMainRefUpdated": {
          "type": "boolean"
        },
        "localDevRefUpdated": {
          "type": "boolean"
        },
        "localWorkspaceUpdated": {
          "type": "boolean"
        }
      }
    },
    "executionStrategy": {
      "type": "string",
      "enum": [
        "CHECKOUT_FREE_REMOTE_SYNC"
      ]
    },
    "watcherSafe": {
      "type": "boolean"
    },
    "currentBranch": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "localHeadBeforeSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "localHeadAfterSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "localDevHeadBeforeSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "remoteDevHeadBeforeSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "remoteDevHeadAfterSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "localMainRefUpdated": {
      "type": "boolean"
    },
    "localDevRefUpdated": {
      "type": "boolean"
    },
    "localWorkspaceUpdated": {
      "type": "boolean"
    },
    "localWorkspaceRefreshRequired": {
      "type": "boolean"
    },
    "localRefreshCommand": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "localHostSyncRequired": {
      "type": "boolean"
    },
    "deferredLocalBranches": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 20
    },
    "localSyncCommandTemplate": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "performanceTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrumentedTotalMs",
        "phases"
      ],
      "properties": {
        "instrumentedTotalMs": {
          "type": "number",
          "minimum": 0
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "label",
              "durationMs"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "transportTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrumentedTotalMs",
        "phases"
      ],
      "properties": {
        "instrumentedTotalMs": {
          "type": "number",
          "minimum": 0
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "label",
              "durationMs"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "processUptimeAtStartMs": {
          "type": "number",
          "minimum": 0
        },
        "processUptimeAtCompleteMs": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
