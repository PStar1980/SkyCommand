{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skycommand.local/contracts/github_dev_pr_merge_summary.v1.schema.json",
  "title": "GitHub DEV Pull Request Merge Summary v1 Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationKind",
    "outcome",
    "repositoryCode",
    "repositoryName",
    "remote",
    "githubRepository",
    "baseBranch",
    "headBranch",
    "expectedDevSha",
    "verifiedDevSha",
    "expectedMainSha",
    "baseShaBeforeMerge",
    "mergedMainSha",
    "prNumber",
    "prUrl",
    "prCreated",
    "createdByRun",
    "mergeMethod",
    "startedAt",
    "completedAt",
    "durationMs",
    "verification"
  ],
  "properties": {
    "operationKind": { "const": "GITHUB_DEV_PR_MERGE" },
    "outcome": { "type": "string", "enum": ["MERGED", "ALREADY_MERGED", "FAILED"] },
    "repositoryCode": { "type": ["string", "null"], "maxLength": 200 },
    "repositoryName": { "type": ["string", "null"], "maxLength": 240 },
    "remote": { "type": ["string", "null"], "maxLength": 1000 },
    "githubRepository": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "baseBranch": { "type": ["string", "null"], "maxLength": 200 },
    "headBranch": { "type": ["string", "null"], "maxLength": 200 },
    "expectedDevSha": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{7,64}$" },
    "verifiedDevSha": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{7,64}$" },
    "expectedMainSha": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{7,64}$" },
    "baseShaBeforeMerge": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{7,64}$" },
    "mergedMainSha": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{7,64}$" },
    "prNumber": { "type": ["integer", "null"], "minimum": 1 },
    "prUrl": { "type": ["string", "null"], "maxLength": 2000 },
    "prCreated": { "type": "boolean" },
    "createdByRun": { "type": ["string", "null"], "maxLength": 100 },
    "mergeMethod": { "type": ["string", "null"], "enum": ["merge", "null"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "durationMs": { "type": "number", "minimum": 0 },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remoteIdentityVerified",
        "devHeadVerified",
        "baseHeadVerified",
        "pullRequestHeadVerified",
        "mergeabilityVerified",
        "resultingMainVerified"
      ],
      "properties": {
        "remoteIdentityVerified": { "type": "boolean" },
        "devHeadVerified": { "type": "boolean" },
        "baseHeadVerified": { "type": "boolean" },
        "pullRequestHeadVerified": { "type": "boolean" },
        "mergeabilityVerified": { "type": "boolean" },
        "resultingMainVerified": { "type": "boolean" }
      }
    }
  }
}
