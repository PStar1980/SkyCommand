{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_authority_snapshot.v1.schema.json",
  "title": "SkyCommand Agent Authority Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "snapshotId",
    "policyRevision",
    "digest",
    "evaluatedAt",
    "requested",
    "configured",
    "granted",
    "constraints",
    "obligations"
  ],
  "properties": {
    "contract": { "const": "agent_authority_snapshot.v1" },
    "snapshotId": { "type": "string", "minLength": 1 },
    "policyRevision": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "minLength": 1 },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "requested": { "$ref": "#/$defs/scope" },
    "configured": { "$ref": "#/$defs/scope" },
    "granted": { "$ref": "#/$defs/scope" },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDurationMs", "maxChildren", "maxConcurrentChildren"],
      "properties": {
        "maxDurationMs": { "type": ["integer", "null"], "minimum": 0 },
        "maxChildren": { "type": ["integer", "null"], "minimum": 0 },
        "maxConcurrentChildren": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "obligations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "resources", "environments", "dataClasses"],
      "properties": {
        "actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "resources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "environments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "dataClasses": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
