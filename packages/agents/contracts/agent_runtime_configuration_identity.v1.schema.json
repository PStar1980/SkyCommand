{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_runtime_configuration_identity.v1.schema.json",
  "title": "SkyCommand Agent Runtime Configuration Identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "runtimeInstallationId",
    "configurationRevision",
    "configurationDigest",
    "capabilityManifestRevision",
    "capabilityManifestDigest",
    "runtimeProfile",
    "freshnessStatus"
  ],
  "properties": {
    "contract": { "const": "agent_runtime_configuration_identity.v1" },
    "runtimeInstallationId": { "type": "string", "minLength": 1 },
    "reviewedSourceRevision": { "type": ["string", "null"] },
    "configurationRevision": { "type": "string", "minLength": 1 },
    "configurationDigest": { "type": "string", "minLength": 1 },
    "capabilityManifestRevision": { "type": "string", "minLength": 1 },
    "capabilityManifestDigest": { "type": "string", "minLength": 1 },
    "runtimeProfile": { "type": "string", "minLength": 1 },
    "processGeneration": { "type": ["string", "null"] },
    "serviceGeneration": { "type": ["string", "null"] },
    "processStartedAt": { "type": ["string", "null"], "format": "date-time" },
    "observedAt": { "type": ["string", "null"], "format": "date-time" },
    "freshnessStatus": {
      "type": "string",
      "enum": ["CURRENT", "STALE_RECONCILABLE", "STALE_BLOCKED", "UNKNOWN"]
    },
    "evidence": {
      "type": ["object", "null"],
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    }
  }
}
