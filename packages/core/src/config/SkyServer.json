          "label": "Run Statistics Canada Ingestion",
          "description": "Loads active Statistics Canada vector-based macroeconomic indicators into PostgreSQL.",
          "file": "packages/ingestion/src/loadStatCanMacroData.js",
          "scriptFile": "packages/ingestion/src/loadStatCanMacroData.js",
          "runtime": "node",
          "visibility": ["cli"],
          "permission": "INGESTION_RUN_STATCAN",
          "risk": "medium",
          "requiresConfirmation": true,
          "confirmationText": "This will call the Statistics Canada ingestion pipeline and write any new data into PostgreSQL.",
          "capturesOutput": true,
