{
  "app": {
    "title": "SkyServer Core",
    "manifestVersion": "2.0.0",
    "description": "Shared operational manifest for SkyServer Core CLI and future Admin-Web/API tool execution."
  },
  "paths": {
    "repoPathConfig": "packages/git/src/config/repo_path.json"
  },
  "categories": [
    {
      "id": "database_tools",
      "name": "Database Tools",
      "label": "Database Tools",
      "description": "PostgreSQL health and build operations.",
      "displayOrder": 10,
      "visibility": ["cli", "admin-web"],
      "enabled": true,
      "scripts": [
        {
          "id": "db_health",
          "name": "db_health",
          "label": "Database Health Check",
          "description": "Tests PostgreSQL connectivity using the configured environment.",
          "file": "packages/db/src/db_health.js",
          "scriptFile": "packages/db/src/db_health.js",
          "runtime": "node",
          "visibility": ["cli", "admin-web"],
          "permission": "DB_HEALTH_RUN",
          "risk": "low",
          "requiresConfirmation": false,
          "capturesOutput": true,
          "enabled": true,
          "displayOrder": 10,
          "allowParams": false,
          "params": []
        },
        {
          "id": "db_build",
          "name": "db_build",
          "label": "Database Build",
          "description": "Rebuilds the PostgreSQL database from ordered migrations and seed files.",
          "file": "packages/db_build/src/db_build.js",
          "scriptFile": "packages/db_build/src/db_build.js",
          "runtime": "node",
          "visibility": ["cli"],
          "permission": "DB_BUILD_RUN",
          "risk": "high",
          "requiresConfirmation": true,
          "confirmationText": "This can drop/rebuild database objects depending on the migration set. Confirm only when you intentionally want to run the database build.",
          "capturesOutput": true,
          "enabled": true,
          "displayOrder": 20,
          "allowParams": false,
          "params": []
        }
      ]
    },
    {
      "id": "auth_tools",
      "name": "Auth Tools",
      "label": "Auth Tools",
      "description": "User, role, permission, and authentication setup utilities.",
      "displayOrder": 15,
      "visibility": ["cli"],
      "enabled": true,
      "scripts": [
        {
          "id": "auth_create_admin_user",
          "name": "createAdminUser",
          "label": "Create Admin User",
          "description": "Creates an ACTIVE SkyServer user and assigns an RBAC role.",
          "file": "packages/auth/src/createAdminUser.js",
          "scriptFile": "packages/auth/src/createAdminUser.js",
          "runtime": "node",
          "visibility": ["cli"],
          "permission": "ADMIN_USER_WRITE",
          "risk": "high",
          "requiresConfirmation": true,
          "confirmationText": "This creates an active user account and assigns a role. Confirm only when intentionally provisioning an admin user.",
          "capturesOutput": true,
          "enabled": true,
          "displayOrder": 10,
          "allowParams": false,
          "params": []
        }
      ]
    },
    {
      "id": "git_tools",
      "name": "Git Tools",
      "label": "Git Tools",
      "description": "Repository status, commit, and merge workflows.",
      "displayOrder": 20,
      "visibility": ["cli", "admin-web"],
      "enabled": true,
      "scripts": [
        {
          "id": "git_repo_status",
          "name": "git_repo_status",
          "label": "Repository Status",
          "description": "Checks configured repository status across dev and main branches.",
          "file": "packages/git/src/git_repo_status.js",
          "scriptFile": "packages/git/src/git_repo_status.js",
          "runtime": "node",
          "visibility": ["cli", "admin-web"],
          "permission": "GIT_STATUS_RUN",
          "risk": "low",
          "requiresConfirmation": false,
          "capturesOutput": true,
          "enabled": true,
          "displayOrder": 10,
          "allowParams": true,
          "params": [
            {
              "name": "repoName",
              "label": "Repository",
              "type": "repo",
              "optionsSource": "repositories",
              "prompt": "Select repository",
              "required": true
            }
          ]
        },
        {
          "id": "dev_commit",
          "name": "dev_commit",
          "label": "Dev Commit",
          "description": "Runs the configured dev branch commit workflow.",
          "file": "packages/git/src/dev_commit.js",
          "scriptFile": "packages/git/src/dev_commit.js",
          "runtime": "node",
          "visibility": ["cli"],
          "permission": "GIT_COMMIT_RUN",
          "risk": "medium",
          "requiresConfirmation": true,
          "confirmationText": "This will stage, commit, and push changes for the selected repository.",
          "capturesOutput": true,
          "enabled": true,
          "displayOrder": 20,
          "allowParams": true,
          "params": [
            {
              "name": "repoName",
              "label": "Repository",
              "type": "repo",
              "optionsSource": "repositories",
              "prompt": "Select repository",
              "required": true
            },
            {
              "name": "commitMessage",
              "label": "Commit Message",
              "type": "string",
              "prompt": "Enter commit message",
              "required": true
            }
          ]
        },
        {
          "id": "main_merge",
          "name": "main_merge",
          "label": "Main Merge",
          "description": "Runs the configured main branch merge and synchronization workflow.",
          "file": "packages/git/src/main_merge.js",
          "scriptFile": "packages/git/src/main_merge.js",
          "runtime": "node",
          "visibility": ["cli"],
          "permission": "GIT_MAIN_MERGE_RUN",
          "risk": "high",
          "requiresConfirmation": true,
          "confirmationText": "This will synchronize main/dev branches and may push branch updates and tags.",
          "capturesOutput": true,
          "enabled": true,
          "displayOrder": 30,
          "allowParams": true,
          "params": [
            {
              "name": "repoName",
              "label": "Repository",
              "type": "repo",
              "optionsSource": "repositories",
              "prompt": "Select repository",
              "required": true
            },
            {
              "name": "tagName",
              "label": "Optional Tag Name",
              "type": "string",
              "prompt": "Optional tag name (leave blank for none)",
              "required": false
            }
          ]
        }
      ]
    },
    {
