          "description": "Loads configured manual spreadsheet or CSV data into PostgreSQL.",
          "file": "packages/ingestion/src/loadManualData.js",
          "scriptFile": "packages/ingestion/src/loadManualData.js",
          "runtime": "node",
          "visibility": ["cli"],
          "permission": "INGESTION_RUN_MANUAL",
          "risk": "medium",
          "requiresConfirmation": true,
          "confirmationText": "This will process the configured manual ingestion file and write mapped data into PostgreSQL.",
          "capturesOutput": true,
          "enabled": true,
          "displayOrder": 40,
          "allowParams": false,
          "params": []
        }
      ]
    },
    {
      "id": "file_tools",
      "name": "File Tools",
      "label": "File Tools",
      "description": "File, documentation, and repository structure utilities.",
      "displayOrder": 40,
      "visibility": ["cli", "admin-web"],
      "enabled": true,
      "scripts": [
        {
          "id": "repo_map_generate",
          "name": "generateRepoMap",
          "label": "Generate Repository Map",
          "description": "Generates a readable repository map for documentation and structural review.",
          "file": "packages/files/src/generateRepoMap.js",
          "scriptFile": "packages/files/src/generateRepoMap.js",
          "runtime": "node",
          "visibility": ["cli", "admin-web"],
          "permission": "REPO_MAP_GENERATE",
          "risk": "low",
          "requiresConfirmation": false,
          "capturesOutput": true,
