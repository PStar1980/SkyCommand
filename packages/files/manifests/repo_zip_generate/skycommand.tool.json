{
  "manifestVersion": "1.0",
  "toolCode": "repo_map_generate",
  "displayName": "Generate Repository Map",
  "description": "Generates a readable repository structure map for documentation and structural review while excluding dependencies, runtime files, sensitive environment files, and generated artifacts.",
  "runtime": {
    "type": "node",
    "entrypoint": "packages/files/src/generateRepoMap.js"
  },
  "parameters": [
    {
      "name": "location",
      "label": "Root Folder Location",
      "description": "Repository or folder to document.",
      "type": "path",
      "required": true,
      "secret": false,
      "binding": {
        "mode": "argv_positional",
        "position": 0
      }
    },
    {
      "name": "file_name",
      "label": "Output File Name",
      "description": "Repository-map output file name.",
      "type": "string",
      "required": true,
      "secret": false,
      "binding": {
        "mode": "argv_positional",
        "position": 1
      }
    },
    {
      "name": "output_path",
      "label": "Optional Output Path",
      "description": "Optional destination folder. When omitted, the map is written in the repository root.",
      "type": "path",
      "required": false,
      "secret": false,
      "defaultValue": "",
      "binding": {
        "mode": "argv_positional",
        "position": 2
      }
    }
  ],
  "resultContract": {
    "required": true,
    "schemaVersion": "1.0",
    "outputType": "repository_map_summary.v1",
    "schemaPath": "packages/tools/contracts/repository_map_summary.v1.schema.json",
    "samplePath": "packages/files/manifests/repo_map_generate/contract-check-result.json"
  },
  "permissions": ["REPO_MAP_GENERATE"],
  "execution": {
    "timeoutMs": 600000,
    "allowManual": true,
    "allowSchedules": true,
    "allowWorkflows": true,
    "capturesOutput": true
  },
  "registration": {
    "applicationCode": "SKYSERVER_CORE",
    "categoryCode": "file_tools",
    "riskCode": "low",
    "requiresConfirmation": false,
    "confirmationText": ""
  }
}
